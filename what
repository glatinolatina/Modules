	QuestSection:Label("dialogue update (71 NPCs reformatted). The")
	QuestSection:Label("entire farm is being rebuilt from scratch.")
	QuestSection:Label("")
	QuestSection:Label("This is a temporary replacement that only")
	QuestSection:Label("supports William Zeppeli (Vampire) quests")
	QuestSection:Label("using the confirmed PromptTriggered method.")
	QuestSection:Label("")
	QuestSection:Label("Toggle below to auto-farm William Zeppeli.")
	QuestSection:Label("")

	QuestSection:Toggle("Auto Farm William Zeppeli", false, function(value)
		if value then
			if getgenv().normalFarmOn or getgenv().afkFarmOn or getgenv().afkUnderneathFarmOn or getgenv().safePlaceFarmOn then
				Window:Notify("Quest", "Item Farm is running! Disable it first.", 3)
				return
			end
		end

		getgenv().ZeppeliFarmEnabled = value

		if value then
			Window:Notify("Quest", "William Zeppeli farm started!", 3)
			enableNoclip()
			FarmState.OriginalCFrame = FarmUtil.GetHRP() and FarmUtil.GetHRP().CFrame
			FarmState.Active = true
			FarmState.CompletedQuest = false
			task.spawn(ZeppeliFarmLoop)
		else
			FarmState.Active = false
			FarmState.CompletedQuest = false
			clearFocusCam(FarmUtil.GetCharacter())
			if FarmState.OriginalCFrame then
				local hrp = FarmUtil.GetHRP()
				if hrp then hrp.CFrame = FarmState.OriginalCFrame end
				FarmState.OriginalCFrame = nil
			end
			Window:Notify("Quest", "William Zeppeli farm stopped!", 3)
			disableNoclip()
		end
	end)

	farmThrottledHeartbeat(function()
		if not FarmState.Active then return end
		local char = Players.LocalPlayer.Character
		if not char then return end
		farmEnsureNoclip(char)
	end, 12, 30)

	notify("", "Mob Farm ready.", 4)
end
